# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://argus:CHANGE_ME@localhost:5432/argus
REDIS_URL=redis://localhost:6380/0

# ─── Authentication ─────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS
API_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS

# ─── GitHub OAuth App ───────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── GitHub Webhooks ────────────────────────────────────────────────
GITHUB_TOKEN=ghp_... # fine-grained PAT with repo scope
GITHUB_WEBHOOK_SECRET=CHANGE_ME

# ─── LLM Backend (Groq) ─────────────────────────────────────────────
ARGUS_LLM_BACKEND=groq
GROQ_API_KEY=gsk_...
ARGUS_GROQ_MODEL=llama-3.3-70b-versatile

# ─── LLM Backend (Anthropic / Ollama alternatives) ──────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ARGUS_ANTHROPIC_MODEL=claude-haiku-4-5
# ARGUS_OLLAMA_BASE_URL=http://localhost:11434

# ─── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Environment ────────────────────────────────────────────────────
ENV=development
