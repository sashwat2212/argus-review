# LLM Backend: "ollama" or "anthropic"
ARGUS_LLM_BACKEND=ollama

# Ollama (local)
ARGUS_OLLAMA_BASE_URL=http://localhost:11434
ARGUS_OLLAMA_MODEL=codellama:13b

# Anthropic (cloud / CI)
# ARGUS_LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ARGUS_ANTHROPIC_MODEL=claude-sonnet-4-6

# API (packages/api)
DATABASE_URL=postgresql+asyncpg://argus:argus_dev@localhost:5432/argus
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# GitHub (CLI + API)
GITHUB_TOKEN=ghp_...
